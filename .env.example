# Display / capture settings
CAPTURE_FPS=0.5
CHAT_REGION_LEFT=10
CHAT_REGION_TOP=850
CHAT_REGION_WIDTH=520
CHAT_REGION_HEIGHT=130
CALIBRATION_MODE=false

# OCR settings
# TESSERACT_PATH=/usr/bin/tesseract
OCR_LANG=eng
ENABLE_EASYOCR=false

# n8n webhook
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/osrs-chat
N8N_SECRET_HEADER=X-OSRS-Secret
N8N_SECRET_VALUE=your-secret-key
BATCH_SIZE=5
BATCH_TIMEOUT_MS=10000

# Message filters
KEYWORD_FILTERS=buying,selling,trade,wts,wtb
IGNORE_PLAYERS=Bot1,Bot2,SpamBot
MIN_CONFIDENCE=0.75

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/osrs_chat.log
MAX_LOG_DAYS=7
